{
  "name": "mathcp",
  "version": "0.1.0",
  "description": "MCP server that gives AI assistants exact maths: \u03c0 to 10,000 digits by ten algorithms, prime numbers and prime-gap analysis, and famous constants explained.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robdabell/mathcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:stdio": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/stdio.js --log-level=warning",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "mcp:local": "node --import tsx src/stdio.ts",
    "start": "node dist/stdio.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "agents": "0.20.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "esbuild": "0.28.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "4.115.0"
  }
}
